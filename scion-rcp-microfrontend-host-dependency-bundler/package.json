{
  "name": "scion-rcp-microfrontend-host-dependency-bundler",
  "scripts": {
    "bundle": "parcel build src/refs.ts --no-cache --dist-dir ../ch.sbb.scion.rcp.microfrontend/js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scion/microfrontend-platform": "3.0.0",
    "@scion/toolkit": "2.1.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "parcel": "2.16.4",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "alias": {
    "process": false,
    "@scion/toolkit/*": "./node_modules/@scion/toolkit/fesm2022/scion-toolkit-$1.mjs"
  }
}
