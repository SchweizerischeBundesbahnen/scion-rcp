{
  "name": "scion-rcp-microfrontend-client-demo-app",
  "scripts": {
    "start": "cpy src/*.json dist && parcel src/*.html --port 4201 --no-cache --open",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scion/microfrontend-platform": "3.0.0",
    "@scion/toolkit": "2.1.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.16.4",
    "@types/node": "26.6.2",
    "cpy-cli": "7.0.0",
    "parcel": "2.16.4",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "alias": {
    "process": false,
    "@scion/toolkit/*": "./node_modules/@scion/toolkit/fesm2022/scion-toolkit-$1.mjs"
  }
}
